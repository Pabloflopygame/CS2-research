# comprueba si tiene el inventario en públicos
.check_inventory_public <- function(steam_id, appid = 730, contextid = 2,
retries = 6, base_delay = 1, timeout = 20, quiet = TRUE) {
url <- sprintf("https://steamcommunity.com/inventory/%s/%s/%s", steam_id, appid, contextid)
h <- curl::new_handle()
curl::handle_setheaders(
h,
"User-Agent" = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36",
"Accept" = "application/json,text/plain,*/*",
"Accept-Encoding" = "gzip, deflate, br",
"Accept-Language" = "en-US,en;q=0.9,es-ES;q=0.8",
"Referer" = "https://steamcommunity.com/"
)
curl::handle_setopt(h, timeout = timeout)
for (i in 0:retries) {
resp <- tryCatch(curl::curl_fetch_memory(url, handle = h), error = function(e) NULL)
if (is.null(resp)) return(NA)
code <- resp$status_code
body <- trimws(rawToChar(resp$content))
if (code == 200) {
if (identical(body, "null")) return(FALSE)  # privado
parsed <- tryCatch(jsonlite::fromJSON(body, simplifyVector = FALSE), error = function(e) NULL)
if (is.null(parsed)) return(NA)             # basura/CAPTCHA
return(isTRUE(parsed$success == 1))         # público (tenga o no ítems)
}
# 429/5xx → reintentos con backoff
if (!quiet) message(sprintf("HTTP %s para %s; reintento %d/%d",
code, steam_id, i + 1, retries))
if (i == retries) return(NA)
Sys.sleep(base_delay * (2^i) + runif(1, 0, 0.5))
}
NA
}
.check_inventory_public("76561198444713323")
# comprueba si tiene el inventario en públicos
.check_inventory_public <- function(steamid) {
# La privacidad del inventario es global; comprobamos el inventario "comunitario" (app 753, context 6)
# Pide 1 item como prueba. Si privado, suele devolver 403.
url <- sprintf("https://steamcommunity.com/inventory/%s/753/6?l=english&count=1", steamid)
req <- request(url) |>
req_user_agent("steam-privacy-check/1.0") |>
req_error(is_error = function(resp) FALSE)
resp <- req_perform(req)
status <- resp_status(resp)
if (status == 200) {
# Si público, devuelve JSON (aunque no haya items) con campos como total_inventory_count o success
js_txt <- resp_body_string(resp)
# Aceptamos como público si el JSON tiene "success" o "total_inventory_count"
has_success <- grepl('"success"', js_txt, fixed = TRUE)
has_total   <- grepl('"total_inventory_count"', js_txt, fixed = TRUE)
return(has_success || has_total)
} else if (status %in% c(401, 403)) {
return(FALSE)  # inventario privado
} else {
return(FALSE)
}
}
.check_inventory_public("76561198444713323")
