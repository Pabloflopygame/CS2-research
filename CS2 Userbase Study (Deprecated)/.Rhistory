check_inventory_public <- function(steam_id, appid = 730, contextid = 2) {
url <- sprintf("https://steamcommunity.com/inventory/%s/%s/%s", steam_id, appid, contextid)
# Obtenemos texto crudo
txt <- tryCatch(
httr2::request(url) |> httr2::req_perform() |> httr2::resp_body_string(),
error = function(e) return(NA_character_)
)
# Si hay error de red, devolvemos NA
if (is.na(txt)) return(NA)
# Caso inventario privado
if (identical(trimws(txt), "null")) return(FALSE)
# Parseamos JSON
res <- jsonlite::fromJSON(txt, simplifyVector = FALSE)
# Si success == 1, inventario público (tenga o no elementos)
return(isTRUE(res$success == 1))
}
.check_inventory_public("76561198444713323")
