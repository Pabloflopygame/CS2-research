library("curl")
library("jsonlite")
# install.packages(c("curl","jsonlite"))  # si no los tienes
check_inventory_public <- function(steam_id, appid = 730, contextid = 2, timeout = 15) {
url <- sprintf("https://steamcommunity.com/inventory/%s/%s/%s", steam_id, appid, contextid)
h <- curl::new_handle()
curl::handle_setheaders(
h,
"User-Agent" = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36",
"Accept" = "application/json,text/plain,*/*",
"Accept-Encoding" = "gzip, deflate, br"
)
curl::handle_setopt(h, timeout = timeout)
resp <- tryCatch(curl::curl_fetch_memory(url, handle = h), error = function(e) e)
if (inherits(resp, "error")) return(NA)                 # error de red
body <- rawToChar(resp$content)
body <- trimws(body)
if (identical(body, "null")) return(FALSE)              # inventario privado
# Si no es "null", intentamos parsear JSON
parsed <- tryCatch(jsonlite::fromJSON(body, simplifyVector = FALSE), error = function(e) e)
if (inherits(parsed, "error")) return(NA)               # respuesta corrupta
isTRUE(parsed$success == 1)                             # público (tenga o no ítems)
}
check_inventory_public("76561198444713323")
